# Copy to .env. Keep the Gemini key on the server and out of source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional completed-audit persistence uses the server's Google identity.
FIRESTORE_PROJECT_ID=
DEFAULT_PROVIDER=rehearsal
DEMO_ACCESS_TOKEN=
MAX_MODEL_CALLS_PER_HOUR=60
MAX_ACTIVE_RUNS=1
PORT=8080
