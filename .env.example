# Copy to .env. Never commit credentials. The browser never receives these values.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional free Firestore audit persistence. Uses the server's Google identity.
FIRESTORE_PROJECT_ID=
# Vertex AI uses Application Default Credentials, including Cloud Run identity.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
VERTEX_MODEL=gemini-3.8-flash
# Optional temporary development provider. This does not satisfy the Google AI requirement.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Azure development uses its own resource endpoint and deployment, not an OpenAI key swap.
# The API key may already be set as a user environment variable.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_BASE_URL=https://YOUR-RESOURCE.openai.azure.com/openai/v1
AZURE_OPENAI_DEPLOYMENT=
# No paid model call is made until the user starts a run or tests the connection.
DEFAULT_PROVIDER=rehearsal
# Optional demo gate: required as X-Demo-Token for paid model runs when configured.
DEMO_ACCESS_TOKEN=
MAX_MODEL_CALLS_PER_HOUR=120
MAX_ACTIVE_RUNS=2
PORT=8080

